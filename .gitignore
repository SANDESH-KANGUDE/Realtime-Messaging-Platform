# ==========================================
# Java / Maven Patterns
# ==========================================
**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/*.nar
**/*.car
**/*.zip
**/*.tar.gz
**/*.rar

# Maven wrapper and local system folders
.mvn/
.metadata/
**/bin/
**/tmp/
**/dependency-reduced-pom.xml

# ==========================================
# Node / React Frontend Patterns
# ==========================================
**/node_modules/
**/dist/
**/dist-ssr/
**/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# ==========================================
# Editor and IDE Files
# ==========================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath
.factorypath
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.user
*.userosscache
*.sln.docstates

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# Docker / Log / Temp Files
# ==========================================
**/*.log
**/logs/
**/postgres_data/
**/mongo_data/
**/redis_data/
**/kafka_data/
**/scratch/
