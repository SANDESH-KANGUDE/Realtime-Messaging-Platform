    {
      "name": "Profiles & Authorization",
      "item": [
        {
          "name": "Get Profile User A",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Negative: Update User B Profile as User A (Forbidden)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Hacked User B\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId_B}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId_B}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Forbidden or method not supported for direct user update', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([403, 405]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
