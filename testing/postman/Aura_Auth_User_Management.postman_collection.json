    {
      "name": "Friendships & Actions",
      "item": [
        {
          "name": "Send Friend Request A -> B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addresseeId\": \"{{userId_B}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/friends/request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "friends", "request"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Request Sent successfully', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set('friendRequestId', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Negative: Duplicate Friend Request A -> B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addresseeId\": \"{{userId_B}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/friends/request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "friends", "request"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejected duplicate request', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 409, 422]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Accept Friend Request",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_B}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/friends/request/{{friendRequestId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "friends", "request", "{{friendRequestId}}", "accept"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Friend request accepted', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
