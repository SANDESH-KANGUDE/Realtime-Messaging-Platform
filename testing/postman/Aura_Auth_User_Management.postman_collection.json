  "item": [
    {
      "name": "User Registration",
      "item": [
        {
          "name": "Register User A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_A}}\",\n  \"username\": \"{{username_A}}\",\n  \"phone\": \"+919999999901\",\n  \"password\": \"P@ssword123\",\n  \"displayName\": \"User A\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var timestamp = Date.now();",
                  "pm.environment.set('email_A', 'usera_' + timestamp + '@example.com');",
                  "pm.environment.set('username_A', 'usera_' + timestamp);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration status is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.userId) {",
                  "    pm.environment.set('userId_A', jsonData.data.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
