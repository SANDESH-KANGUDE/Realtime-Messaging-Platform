        }
      ]
    },
    {
      "name": "Outbox Pipeline Resiliency Test",
      "item": [
        {
          "name": "Step 1: Verify Message Endpoint works (Kafka Active)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chatId\": \"{{chatId_direct}}\",\n  \"type\": \"TEXT\",\n  \"content\": \"Resilience Test Message 1: Kafka is UP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Message created under normal conditions', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Step 2: Stop Kafka and POST new message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chatId\": \"{{chatId_direct}}\",\n  \"type\": \"TEXT\",\n  \"content\": \"Resilience Test Message 2: Kafka is DOWN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Message creation succeeds even when Kafka is down', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "// Action REQUIRED: run sql/verify_outbox_mongo.js in mongodb shell",
                  "// Verify that outbox_messages collection contains a document with status 'PENDING'"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Step 3: Start Kafka and check publication recovery",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/chat/{{chatId_direct}}?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages", "chat", "{{chatId_direct}}"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Action REQUIRED: Start Kafka container (docker start chat_kafka)",
                  "// Wait 15 seconds, execute this request.",
                  "// Verify that outbox_messages status has recovered to 'PUBLISHED' in Mongo",
                  "pm.test('History shows messages are successfully listed', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Redis Session & Presence Failover Test",
      "item": [
        {
          "name": "Step 1: Read Profile with Redis Offline",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Action REQUIRED: Stop Redis container (docker stop chat_redis)",
                  "// Verify that you can still read your profile (as security uses local JWT parse fallback or direct DB check)",
                  "pm.test('Read profile is responsive', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
