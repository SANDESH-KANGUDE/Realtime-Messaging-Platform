    },
    {
      "name": "Media Upload Lifecycle",
      "item": [
        {
          "name": "Request Upload URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"test_image.png\",\n  \"fileType\": \"image/png\",\n  \"fileSize\": 102400\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/media/upload-url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "media", "upload-url"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Upload URL generated', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.mediaId) {",
                  "    pm.environment.set('mediaId', jsonData.data.mediaId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Negative: Invalid MIME Type Check",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"malicious.sh\",\n  \"fileType\": \"application/x-sh\",\n  \"fileSize\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/media/upload-url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "media", "upload-url"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejected malicious script upload', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Complete Upload Metadata",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/media/{{mediaId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "media", "{{mediaId}}", "complete"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Upload completion recorded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Search & Index Projections",
      "item": [
        {
          "name": "Send Searchable Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chatId\": \"{{chatId_direct}}\",\n  \"type\": \"TEXT\",\n  \"content\": \"I have a unique token called spring-testing-aura-99 here!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages"]
            }
          },
          "response": []
        },
        {
          "name": "Query Search Index",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken_A}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/search?q=spring-testing-aura-99&type=messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "spring-testing-aura-99"
                },
                {
                  "key": "type",
                  "value": "messages"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Search returns index match', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    // Assert results array is not empty and matches search keyword",
                  "    var results = jsonData.data || jsonData.results;",
                  "    pm.expect(results).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
