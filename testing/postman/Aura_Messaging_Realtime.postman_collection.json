{
  "info": {
    "_postman_id": "7b8f9e6a-c21d-4001-ba1b-cc893f18e19e",
    "name": "Aura 3: Messaging & Realtime Core",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
